    <widget class="QLabel" name="labelIntro">
     <property name="text">
      <string>Crops both temporomandibular joints of a CBCT. The scan is oriented to the Frankfurt horizontal frame, the mandible is segmented, and a box of 96 x 112 x 80 voxels at 0.3 mm is cut around each condyle. The left crop is mirrored so both joints look alike.</string>
     </property>
     <property name="wordWrap"><bool>true</bool></property>
